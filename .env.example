# کپی کنید به .env (یا همین مقادیر را در بخش «متغیرهای محیطی» پنل میزبانی وارد کنید). هرگز .env را در گیت قرار ندهید.

# پورت را معمولاً خود میزبان می‌دهد؛ اگر نداد این مقدار استفاده می‌شود
PORT=3000

# مسیر ذخیره‌ساز دائمی (دیتابیس، تصاویر، پشتیبان‌ها). حتماً روی دیسکی باشد که با ری‌استارت پاک نمی‌شود.
DATA_DIR=./data

# حساب مالک (فقط در اولین اجرا ساخته می‌شود). اگر رمز را خالی بگذارید، رمز تصادفی در لاگ سرور چاپ می‌شود.
OWNER_PHONE=09039665868
OWNER_PASSWORD=

# ورود با گوگل (اختیاری): Client ID از Google Cloud Console
GOOGLE_CLIENT_ID=

# آدرس نهایی سایت با دامنه اختصاصی (برای canonical و sitemap)
SITE_URL=

# تعداد نسخه‌های پشتیبان خودکار روزانه
BACKUP_KEEP=7
# اگر فایل‌سیستم میزبان با WAL مشکل داشت: DELETE
SQLITE_JOURNAL=WAL

# ---- حالت ورسل + سوپابیس (به‌جای SQLite) ----
# اگر DB_GATEWAY_URL تنظیم باشد برنامه به‌جای SQLite از Postgres سوپابیس (از طریق Edge Function) استفاده می‌کند
DB_GATEWAY_URL=
DB_GATEWAY_KEY=
STORAGE_PUBLIC_URL=
